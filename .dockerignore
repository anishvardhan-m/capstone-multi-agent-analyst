# Environment / secrets
.env
*.env

# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Data (large/raw, regenerate via data/flatten_olist.py; keep image lean)
data/raw/*.csv
data/processed/*.csv

# Models (large trained-model binaries; not needed to build the image)
models/*.pkl

# Workspace runtime artifacts (generated at container run time, not build time)
workspace/visualizations/*.png
workspace/metadata/*.db
workspace/*.pdf
workspace/*.md
workspace/*.log

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

RAW_DATASETS/

# Docs not needed inside the image. KNOWN_LIMITATIONS.md is deliberately
# NOT listed here -- app/pages/7_Reports_Hub.py reads it at runtime to
# render the dashboard's "Known Limitations" section; excluding it doesn't
# crash the page (it degrades to "not found"), but silently drops a real
# feature from every Docker deploy.
docs/
