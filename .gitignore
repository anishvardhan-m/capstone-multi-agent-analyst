# Environment / secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Data (raw data can be large; keep repo lean, document how to regenerate)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models (large binaries)
models/*.pkl
!models/.gitkeep

# Workspace runtime artifacts
workspace/visualizations/*.png
workspace/metadata/*.db
!workspace/visualizations/.gitkeep
!workspace/metadata/.gitkeep

# Exception: the Olist demo run's chart images and audit DB are committed
# on purpose so the deployed dashboard (Streamlit Community Cloud) shows
# real results on every page without anyone running the pipeline live.
# agent_activity.log is NOT included here -- it's just a text log, not
# needed for display, and stays covered by the *.log rule below.
!workspace/visualizations/*.png
!workspace/metadata/audit_telemetry.db

# run_id-namespaced workspace outputs (workspace/<run_id>/...): every
# dataset run through the Dataset Ingestion page with a run_id gets its
# own charts/PDF/narrative here. Unlike the Olist demo's fixed top-level
# paths above, these are per-run artifacts never meant to be committed --
# without this, they're untracked but NOT ignored, so an unqualified
# `git add -A` would sweep in large per-dataset binaries.
workspace/*/visualizations/*.png
workspace/*/*.pdf
workspace/*/*.md

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
RAW_DATASETS/
